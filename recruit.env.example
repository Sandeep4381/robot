# Add settings to .env. Never commit credentials.
AI_PROVIDER=none
OLLAMA_MODEL=qwen2.5:3b
# For paid OpenAI later, set AI_PROVIDER=openai and supply the key below.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
Linkedin_tanlent=https://www.linkedin.com/talent/home/
CEIPAL_SOURCE=LinkedIn Resume Harvesting
# Keep LINKEDIN_EMAIL/PASSWORD and CEIPAL_EMAIL/PASSWORD in .env.
# Code=optional authenticator secret

# Optional job/search selectors.
CEIPAL_JOB_LINK_SELECTOR=
CEIPAL_JOB_TITLE_SELECTOR=
CEIPAL_JOB_LOCATION_SELECTOR=
LINKEDIN_JOB_TITLE_SELECTOR=
LINKEDIN_LOCATION_SELECTOR=
LINKEDIN_RESULT_SELECTOR=a[href*="/talent/profile/"]
LINKEDIN_NEXT_PAGE_SELECTOR=
# Scope to the profile panel if Talent has no main element.
LINKEDIN_PROFILE_CONTENT_SELECTOR=

# Resume parsing into Ceipal; defaults are the observed controls.
CEIPAL_PARSE_RESUME_SELECTOR=
CEIPAL_PARSE_SAVE_SELECTOR=
